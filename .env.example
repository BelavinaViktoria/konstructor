# Скопируйте в файл .env и заполните. Файл .env в GitHub не попадает.

# Обязательно на сервере. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development или production
APP_ENV=development

# По умолчанию SQLite в папке instance/. На сервере лучше PostgreSQL.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

COMPANY_NAME=Ваша компания
BASE_URL=http://localhost:5000

# Необязательно: письма. Без SMTP_HOST уведомления видны только внутри приложения.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Необязательно: ключи входящих интеграций. Пока ключ пуст, интеграция выключена.
POTOK_API_KEY=
FORMS_API_KEY=

# Необязательно: ИИ на базе Claude. Без ключа работает разбор по правилам.
# Перед включением согласуйте передачу данных во внешний сервис с безопасностью компании.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
